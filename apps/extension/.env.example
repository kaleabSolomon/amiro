# Origin allowed to hand the extension a session. The background rejects a
# handshake from anywhere else, so a production build MUST set this or it will
# refuse to connect to the deployed web app.
VITE_AMIRO_WEB_URL=https://amiro-web.vercel.app

# Optional: pins the backend at build time. When set, a compromised web app
# cannot redirect captures to another Convex deployment.
VITE_AMIRO_CONVEX_SITE_URL=https://opulent-ram-179.convex.site
