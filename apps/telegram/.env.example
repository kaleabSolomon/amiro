# Required
TELEGRAM_BOT_TOKEN=

# polling | webhook
TELEGRAM_BOT_MODE=webhook

# Public HTTPS webhook URL (must include path)
# Example with zrok: https://gbtx74jwcp6h.share.zrok.io/telegram/webhook
TELEGRAM_WEBHOOK_URL=

# Webhook request verification secret. Generate a random value.
# Example command: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Local webhook route path and server port
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_PORT=3020

# Comma-separated update types.
TELEGRAM_ALLOWED_UPDATES=message,channel_post

# Default tags attached to parsed captures.
AMIRO_TELEGRAM_DEFAULT_TAGS=source:telegram
